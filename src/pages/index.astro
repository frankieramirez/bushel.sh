---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import Command from "../components/Command.astro";
import Masthead from "../components/Masthead.astro";
import Colophon from "../components/Colophon.astro";
import { DOCS_PAGES } from "../lib/docs";
import { bushelDocs } from "../lib/bushelDocs";

const INSTALL = "curl -LsSf https://bushel.sh/install | sh";
const BREW = "brew install frankieramirez/tap/bushel";
const CARGO = "cargo install bushel";

const ROADMAP = "https://github.com/frankieramirez/bushel/issues/56";

const { version } = await bushelDocs();

const description =
  "Browse Apple containers, images, volumes and networks in bushel. Choose a rail or table layout, watch live container telemetry, and review destructive commands before they run.";

/** The packing list: one figure, one label, one line each. */
const items = [
  {
    num: "4",
    label: "panes",
    body: "Containers, images, volumes and networks, all in one window.",
  },
  {
    num: "2",
    label: "layouts",
    body: 'A rail beside the detail pane, or the table at full width. Press <span class="mono">,</span> for settings to switch.',
  },
  {
    num: "1",
    label: "confirmation",
    body: 'Delete, prune and kill print the exact <span class="mono">container</span> command before anything runs.',
  },
  {
    num: "150",
    label: "ms, tops",
    body: 'Every animation yields to input and none of it delays a keystroke. <span class="mono">--reduced-motion</span> turns it all off.',
  },
  {
    num: "0",
    label: "leaks",
    body: 'bushel owns its <span class="mono">logs -f</span> tails and kills them when a container stops.',
  },
  {
    num: "1",
    label: "key to a shell",
    body: 'Press <span class="mono">e</span>. bushel steps aside for <span class="mono">container exec -it</span>, then puts the layout back.',
  },
];

/*
 * The tear-off strip. One tab is already gone, the way a flyer looks once a
 * few people have walked past it.
 */
const tabs = [INSTALL, BREW, CARGO, INSTALL, null, CARGO];

const contents = [
  ...DOCS_PAGES.map((page) => ({ ...page, external: false })),
  {
    no: "·",
    title: "Roadmap",
    href: ROADMAP,
    summary: "What's shipped and what's still to come.",
    external: true,
  },
];
---

<Base
  title="bushel: a terminal UI for Apple Containers"
  description={description}
>
  <a class="skip-link" href="#main">Skip to content</a>

  <Masthead />

  <main id="main">
    <!-- ══ the cover ══ -->
    <section class="hero">
      <div class="wrap">
        <div class="hero-eq">
          <p class="slug">A terminal UI for Apple Containers · macOS 26</p>
          <h1 class="display">
            <span class="eq-head">1 bushel</span>
            <span class="eq-line">= 4 panes</span>
            <span class="eq-line">= 2 layouts</span>
            <span class="eq-line">= 1 binary</span>
          </h1>
        </div>

        <div class="taped">
          <img
            src="/img/bushel-riso.webp"
            srcset="/img/bushel-riso-448.webp 448w, /img/bushel-riso.webp 896w"
            sizes="(min-width: 1000px) 33vw, 320px"
            width="896"
            height="1200"
            alt=""
            fetchpriority="high"
          />
          <p class="sticker" aria-hidden="true">
            <span class="sticker-fresh">Fresh</span>
            <span class="sticker-meta">v{version}<br />macOS 26</span>
          </p>
        </div>

        <div class="hero-pitch">
          <p class="hero-lede">
            bushel is a terminal UI for Apple's <span class="mono"
              >container</span
            > CLI. Browse containers, images, volumes and networks in four panes,
            watch live telemetry on the one you've picked, and read every destructive
            command before it runs.
          </p>

          <Command command={INSTALL} />

          <p class="hero-note">
            <span class="slug is-blue">No Homebrew needed</span>
            <a class="slug" href="#take-one"
              >More ways to take one <Arrow dir="down" /></a
            >
          </p>
        </div>
      </div>
    </section>

    <!-- ══ sec. 01 — packing list ══ -->
    <section class="sheet packing" aria-labelledby="packing-heading">
      <div class="wrap">
        <header class="sheet-head">
          <div>
            <p class="slug">Sec. 01 · Packing list</p>
            <h2 class="display" id="packing-heading">What's in the bushel</h2>
          </div>
          <p class="sheet-lede">
            Create containers with Apple's CLI, then manage them here. Pull and
            tag images, make named volumes, and inspect the networks you already
            have.
          </p>
        </header>

        <ul class="items">
          {
            items.map((item) => (
              <li class="item">
                <h3 class="figure display">
                  <span class="figure-num">{item.num}</span>{" "}
                  <span class="figure-label">{item.label}</span>
                </h3>
                <p set:html={item.body} />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ══ sec. 02 — fig. a, the recording ══ -->
    <section class="sheet fig-a" aria-labelledby="fig-a-heading">
      <div class="wrap">
        <header class="sheet-head">
          <div>
            <p class="slug">Sec. 02 · Fig. A</p>
            <h2 class="display" id="fig-a-heading">The actual thing</h2>
          </div>
          <p class="sheet-lede">
            A recorded session, printed in two inks. It plays muted, and stops
            when you scroll past it.
          </p>
        </header>

        <div class="shot-stage">
          <figure class="shot">
            <video
              id="demo-video"
              autoplay
              muted
              loop
              playsinline
              width="1200"
              height="760"
              poster="/demo/bushel-demo-poster.jpg"
              aria-label="A recorded bushel session showing the rail, live container telemetry, log follow, and container actions."
            >
              <source src="/demo/bushel-demo.webm" type="video/webm" />
              <source src="/demo/bushel-demo.mp4" type="video/mp4" />
            </video>

            <!--
              Runs during parse, before autoplay can begin — the module script
              below is deferred, and by the time it ran the recording would
              already be moving. bushel turns its own motion off on request; so
              does its landing page.
            -->
            <script is:inline>
              (function () {
                if (!matchMedia("(prefers-reduced-motion: reduce)").matches)
                  return;
                var video = document.getElementById("demo-video");
                if (!video) return;
                video.autoplay = false;
                video.removeAttribute("autoplay");
                video.pause();
                video.dataset.reducedMotion = "true";
              })();
            </script>

            <svg
              class="shot-ring"
              viewBox="0 0 100 100"
              preserveAspectRatio="none"
              aria-hidden="true"
              focusable="false"
            >
              <ellipse cx="50" cy="50" rx="48" ry="45" transform="rotate(-2 50 50)"
              ></ellipse>
            </svg>
          </figure>

          <ol class="shot-notes" aria-label="What the recording shows">
            <li>
              <span>the rail: every pane, and the one you're on</span>
              <Arrow dir="right" class="note-arrow" />
            </li>
            <li>
              <Arrow dir="left" class="note-arrow" />
              <span>live cpu and memory for the selection</span>
            </li>
            <li>
              <Arrow dir="left" class="note-arrow" />
              <span>the log tail, following. F and w toggle follow and wrap.</span>
            </li>
            <li>
              <span>the keys that matter right now, always on screen</span>
            </li>
          </ol>

          <div class="shot-controls">
            <button
              type="button"
              class="shot-toggle"
              data-demo-toggle
              aria-controls="demo-video">Pause</button
            >
            <a href="/docs/usage">Using bushel <Arrow dir="right" /></a>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ sec. 03 — take one ══ -->
    <section class="sheet take" id="take-one" aria-labelledby="take-heading">
      <div class="wrap">
        <div class="flyer">
          <div class="flyer-body">
            <p class="flyer-head display" aria-hidden="true">
              <span class="is-pink">Free</span>
              <span class="is-blue">bushel.</span>
            </p>
            <p>
              One binary on top of Apple's <span class="mono">container</span>
              CLI. For macOS 26 on Apple silicon, tested with container 1.2.x.
              Upgrade any time with <span class="mono">bushel update</span>.
            </p>
            <p class="slug">Please take one <Arrow dir="down" /></p>
          </div>

          <!--
            Pointer-only: every command here is also in the list beside the
            flyer, where it has a labelled copy button for keyboard and screen
            reader users.
          -->
          <ul class="tabs" aria-hidden="true">
            {
              tabs.map((command) =>
                command ? (
                  <li class="tab">
                    <button
                      type="button"
                      class="tab-button"
                      tabindex="-1"
                      data-copy={command}
                      data-tear
                    >
                      <span>{command}</span>
                    </button>
                  </li>
                ) : (
                  <li class="tab is-gone" />
                ),
              )
            }
          </ul>
        </div>

        <div class="ways">
          <div>
            <p class="slug">Sec. 03 · Take one</p>
            <h2 class="display" id="take-heading">Three ways in</h2>
          </div>

          <div class="way">
            <p class="way-label">
              Shell <span class="slug">Start here</span>
            </p>
            <Command command={INSTALL} />
          </div>

          <div class="way">
            <p class="way-label">Homebrew</p>
            <Command command={BREW} outline />
          </div>

          <div class="way">
            <p class="way-label">Cargo</p>
            <Command command={CARGO} outline />
          </div>

          <p class="ways-note">
            bushel warns on container versions it hasn't been tested against, but
            still runs. Install prefixes, completions and the man page are in the
            <a href="/docs/install">install docs</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- ══ sec. 04 — contents ══ -->
    <section class="contents" aria-labelledby="contents-heading">
      <div class="wrap">
        <p class="slug">Sec. 04 · Contents</p>
        <h2 class="display" id="contents-heading">The rest is in the docs</h2>

        <ol class="toc-list">
          {
            contents.map((entry) => (
              <li>
                <a href={entry.href}>
                  <span class="toc-no">{entry.no}</span>
                  <span>
                    <span class="toc-title">{entry.title}</span>
                    <span class="toc-sum">{entry.summary}</span>
                  </span>
                  <Arrow
                    dir={entry.external ? "up-right" : "right"}
                    class="toc-arrow"
                  />
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
  </main>

  <Colophon />

  <p class="visually-hidden" role="status" data-copy-status></p>
</Base>

<script>
  // ── copying, and tearing off a tab ──────────────────────────────────────
  const RESET_MS = 1600;
  const REGROW_MS = 2600;

  const status = document.querySelector<HTMLElement>("[data-copy-status]");

  document
    .querySelectorAll<HTMLButtonElement>("button[data-copy]")
    .forEach((button) => {
      const command = button.dataset.copy ?? "";
      const label = button.querySelector<HTMLElement>(".copy-label");
      const tab = button.hasAttribute("data-tear")
        ? button.closest<HTMLElement>(".tab")
        : null;
      let timer: number | undefined;

      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(command);
        } catch {
          return; // no clipboard here — leave the affordance untouched
        }

        if (status) status.textContent = `Copied: ${command}`;
        window.clearTimeout(timer);

        // A tear-off tab comes away in the hand and grows back a moment later.
        if (tab) {
          const lean = (Math.random() * 10 - 5).toFixed(1);
          tab.style.setProperty("--tear", `${lean}deg`);
          tab.dataset.torn = "";
          timer = window.setTimeout(() => {
            delete tab.dataset.torn;
          }, REGROW_MS);
          return;
        }

        button.dataset.copied = "true";
        button.setAttribute("aria-label", `Copied: ${command}`);
        if (label) label.textContent = "Copied";

        timer = window.setTimeout(() => {
          delete button.dataset.copied;
          button.setAttribute("aria-label", `Copy command: ${command}`);
          if (label) label.textContent = "Copy";
        }, RESET_MS);
      });
    });

  // ── the recording ───────────────────────────────────────────────────────
  const video = document.querySelector<HTMLVideoElement>("#demo-video");
  const toggle = document.querySelector<HTMLButtonElement>("[data-demo-toggle]");

  if (video && toggle) {
    // The inline script above already stopped the recording for a reader who
    // asked for reduced motion, and left this flag behind saying so.
    // What the reader last asked for — the observer only resumes what they left running.
    let wantsPlay = video.dataset.reducedMotion !== "true";

    // The label reports what the reader asked for, not what the observer did —
    // scrolling the demo out of view pauses it without flipping the control.
    const render = () => {
      toggle.textContent = wantsPlay ? "Pause" : "Play";
      toggle.setAttribute(
        "aria-label",
        wantsPlay ? "Pause the recording" : "Play the recording",
      );
    };

    toggle.addEventListener("click", () => {
      wantsPlay = !wantsPlay;
      if (wantsPlay) void video.play().catch(() => {});
      else video.pause();
      render();
    });

    render();

    // Off-screen the recording earns nothing — stop decoding it.
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!wantsPlay) continue;
            if (entry.isIntersecting) void video.play().catch(() => {});
            else video.pause();
          }
        },
        { threshold: 0.15 },
      ).observe(video);
    }
  }
</script>
