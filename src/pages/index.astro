---
import Base from "../layouts/Base.astro";
import BasketMark from "../components/BasketMark.astro";
import Command from "../components/Command.astro";
import Masthead from "../components/Masthead.astro";
import Colophon from "../components/Colophon.astro";

const INSTALL = "curl -LsSf https://bushel.sh/install | sh";

const description =
  "bushel manages the containers, images and volumes already on your Mac. All three sit on one rail with live telemetry on whatever you have selected, and anything destructive shows you the exact container command before it runs.";

const features = [
  {
    no: "01",
    head: ["One rail,", "all three"],
    body: "Containers, images and volumes stay on screen together. The active pane takes the space; the others collapse to a name or a count.",
  },
  {
    no: "02",
    head: ["Telemetry on", "the selection"],
    body: "CPU and memory sparklines with network and disk rates, sampled every poll tick. There is nothing to configure and no dashboard to open.",
  },
  {
    no: "03",
    head: ["The command,", "before it runs"],
    body: 'Delete, prune and kill each show the exact <span class="mono">container …</span> line in the confirmation, so you read what will run before you agree to it.',
  },
  {
    no: "04",
    head: ["Logs that", "keep up"],
    body: 'A bounded tail with follow and wrap toggles. bushel owns its <span class="mono">logs -f</span> subprocesses and kills them, so nothing leaks when a container stops.',
  },
  {
    no: "05",
    head: ["Drop into", "a shell"],
    body: 'Press <span class="mono">e</span>. bushel suspends itself, hands stdio to <span class="mono">container exec -it</span>, and restores the layout when you exit.',
  },
  {
    no: "06",
    head: ["Motion you", "never wait on"],
    body: 'Every animation caps at 150 ms and yields to input, and none of them delay data or keystrokes. <span class="mono">--reduced-motion</span> turns all of it off.',
  },
];
---

<Base
  title="bushel: a terminal UI for Apple Containers"
  description={description}
>
  <a class="skip-link" href="#main">Skip to content</a>

  <Masthead />

  <main id="main">
    <!-- ══ hero ══ -->
    <section class="hero">
      <div class="wrap">
        <div class="hero-copy">
          <p class="eyebrow">Containers · Images · Volumes</p>

          <h1>A terminal UI<br />for <em>Apple<br />Containers</em></h1>

          <p class="hero-lede">
            bushel manages the containers, images and volumes already on your
            Mac. All three sit on one rail with live telemetry on whatever you
            have selected, and anything destructive shows you the exact <span
              class="mono">container</span
            > command before it runs.
          </p>

          <Command command={INSTALL} />

          <p class="hero-note">
            No Homebrew required · <a href="#install">brew and cargo below</a>
          </p>
        </div>

        <BasketMark size={320} class="hero-mark" />
      </div>
    </section>

    <!-- ══ fig 01 — the demo ══ -->
    <section class="demo" aria-labelledby="fig-01">
      <div class="wrap">
        <h2 class="fig" id="fig-01">
          <span class="fig-no">Fig. 01</span>
          <span class="fig-name"
            >The rail, the detail pane, the action menu</span
          >
        </h2>

        <figure class="terminal-figure">
          <div class="terminal">
            <div class="terminal-bar">
              <span class="terminal-lights" aria-hidden="true">
                <span style="background:#ff7b72"></span>
                <span style="background:#e3b341"></span>
                <span style="background:#7ee787"></span>
              </span>
              <span class="terminal-title">bushel · recorded session</span>
              <button
                type="button"
                class="terminal-toggle"
                data-demo-toggle
                aria-controls="demo-video"
                aria-label="Pause the demo">PAUSE</button
              >
            </div>

            <video
              id="demo-video"
              autoplay
              muted
              loop
              playsinline
              width="1200"
              height="760"
              poster="/demo/bushel-demo-poster.jpg"
              aria-label="A recorded bushel session: the rail of running containers with live CPU and memory, the detail pane following a worker's logs, then a container stopped and started again, each confirmed with the exact container command."
            >
              <source src="/demo/bushel-demo.webm" type="video/webm" />
              <source src="/demo/bushel-demo.mp4" type="video/mp4" />
            </video>

            <!--
              Runs during parse, before autoplay can begin — the module script
              below is deferred, and by the time it ran the recording would
              already be moving. bushel turns its own motion off on request; so
              does its landing page.
            -->
            <script is:inline>
              (function () {
                if (!matchMedia("(prefers-reduced-motion: reduce)").matches)
                  return;
                var video = document.getElementById("demo-video");
                if (!video) return;
                video.autoplay = false;
                video.removeAttribute("autoplay");
                video.pause();
                video.dataset.reducedMotion = "true";
                var toggle = document.querySelector("[data-demo-toggle]");
                if (toggle) {
                  toggle.textContent = "PLAY";
                  toggle.setAttribute("aria-label", "Play the demo");
                }
              })();
            </script>
          </div>

          <figcaption class="demo-caption">
            A real session: the rail, log follow, and a confirmed stop and
            start
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ══ fig 02 — features, ink reversed ══ -->
    <section class="band-cream" aria-labelledby="features-heading">
      <div class="wrap">
        <p class="fig">
          <span class="fig-no">Fig. 02</span>
          <span class="fig-name">What is in the box</span>
        </p>

        <h2 class="band-heading" id="features-heading">
          For the containers<br class="br-wide" /> you already have.
        </h2>

        <p class="band-lede">
          Containers are born on the command line. bushel manages what already
          exists, and does it without hiding what it is doing.
        </p>

        <div class="features">
          {
            features.map((feature) => (
              <article class="feature">
                <span class="feature-no">{feature.no}</span>
                <h3>
                  {feature.head[0]} <br class="br-wide" />
                  {feature.head[1]}
                </h3>
                <p set:html={feature.body} />
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ══ fig 03 — install ══ -->
    <section class="install" id="install" aria-labelledby="install-heading">
      <div class="wrap">
        <p class="fig">
          <span class="fig-no">Fig. 03</span>
          <span class="fig-name">Three ways to unpack it</span>
        </p>

        <h2 class="install-heading" id="install-heading">Install</h2>

        <p class="install-lede">
          One binary on top of Apple's <a
            href="https://github.com/apple/container">container</a
          > CLI. The <a href="/docs/install#what-bushel-needs">requirements</a>
          are in the docs; bushel warns on untested versions but still runs.
        </p>

        <div class="methods">
          <div class="method">
            <span class="method-label is-start">
              Shell
              <span class="method-start">Start here</span>
            </span>
            <Command command={INSTALL} compact />
          </div>

          <div class="method">
            <span class="method-label">Homebrew</span>
            <Command command="brew install frankieramirez/tap/bushel" compact />
          </div>

          <div class="method">
            <span class="method-label">From source</span>
            <Command
              command="cargo install --git https://github.com/frankieramirez/bushel"
              compact
            />
          </div>
        </div>

        <div class="install-notes">
          <p>
            Upgrade with <span class="mono">bushel update</span>, whichever way
            it went in. Install prefixes, the shell rc, and what each method
            does on update are in the <a href="/docs/install">install docs</a>.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Colophon />
</Base>

<script>
  // ── copy affordances ────────────────────────────────────────────────────
  const RESET_MS = 1600;

  document
    .querySelectorAll<HTMLButtonElement>("button[data-copy]")
    .forEach((button) => {
      const command = button.dataset.copy ?? "";
      const label = button.querySelector<HTMLElement>(".copy-label");
      const restore = label?.textContent ?? "";
      let timer: number | undefined;

      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(command);
        } catch {
          return; // no clipboard here — leave the affordance untouched
        }

        button.dataset.copied = "true";
        button.setAttribute("aria-label", `Copied: ${command}`);
        if (label) label.textContent = "COPIED";

        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          delete button.dataset.copied;
          button.setAttribute("aria-label", `Copy command: ${command}`);
          if (label) label.textContent = restore;
        }, RESET_MS);
      });
    });

  // ── the demo ────────────────────────────────────────────────────────────
  const video = document.querySelector<HTMLVideoElement>("#demo-video");
  const toggle = document.querySelector<HTMLButtonElement>("[data-demo-toggle]");

  if (video && toggle) {
    // The inline script above already stopped the recording for a reader who
    // asked for reduced motion, and left this flag behind saying so.
    // What the reader last asked for — the observer only resumes what they left running.
    let wantsPlay = video.dataset.reducedMotion !== "true";

    // The label reports what the reader asked for, not what the observer did —
    // scrolling the demo out of view pauses it without flipping the control.
    const render = () => {
      toggle.textContent = wantsPlay ? "PAUSE" : "PLAY";
      toggle.setAttribute(
        "aria-label",
        wantsPlay ? "Pause the demo" : "Play the demo",
      );
    };

    toggle.addEventListener("click", () => {
      wantsPlay = !wantsPlay;
      if (wantsPlay) void video.play().catch(() => {});
      else video.pause();
      render();
    });

    render();

    // Off-screen the recording earns nothing — stop decoding it.
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!wantsPlay) continue;
            if (entry.isIntersecting) void video.play().catch(() => {});
            else video.pause();
          }
        },
        { threshold: 0.15 },
      ).observe(video);
    }
  }
</script>
