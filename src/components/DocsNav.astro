---
/**
 * The docs contents list. One element, two shapes: a sticky numbered column
 * beside the prose on a wide screen, a horizontally scrolling label ribbon
 * under the masthead on a phone. Both are the same markup — see `.docs-nav`
 * in global.css — so a screen reader is never offered the links twice.
 */
import ExternalArrow from "./ExternalArrow.astro";
import { DOCS_PAGES } from "../lib/docs";
import { normalisePath } from "../lib/url";

const ROADMAP = "https://github.com/frankieramirez/bushel/issues/56";

const path = normalisePath(Astro.url.pathname);
---

<nav class="docs-nav" aria-label="Docs">
  <p class="slug docs-nav-label">Contents</p>
  <ol class="docs-nav-list">
    {
      DOCS_PAGES.map((page) => {
        const current = page.href === path;
        return (
          <li>
            <a
              href={page.href}
              title={page.summary}
              aria-current={current ? "page" : undefined}
            >
              <span class="docs-nav-no">{page.no}</span>
              <span class="docs-nav-title">{page.title}</span>
            </a>
          </li>
        );
      })
    }
    <li>
      <a href={ROADMAP} title="What's shipped and what's still to come">
        <span class="docs-nav-no"><ExternalArrow /></span>
        <span class="docs-nav-title">Roadmap</span>
      </a>
    </li>
  </ol>
</nav>
