---
/**
 * A shell command with a copy affordance. `command` is both what is shown after
 * the prompt and what lands on the clipboard — the `$` never gets copied.
 */
interface Props {
  command: string;
  /** Printed in outline rather than solid, for the methods after the first. */
  outline?: boolean;
}

const { command, outline = false } = Astro.props;
---

<div class:list={["cmd", { "is-outline": outline }]}>
  <code class="cmd-line"
    ><span class="cmd-prompt" aria-hidden="true">$</span><span
      >{command}</span
    ></code
  >
  <button
    type="button"
    class="copy"
    data-copy={command}
    aria-label={`Copy command: ${command}`}
  >
    <span class="copy-label">Copy</span>
  </button>
</div>
