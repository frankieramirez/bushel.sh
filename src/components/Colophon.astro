---
/**
 * The colophon, shared by the landing page and the docs so a reader never
 * falls off the bottom of one into a different-looking site.
 *
 * The sign-off is the wordmark pulled twice, once per ink, and set a little out
 * of register. global.css lets the blue plate drift as it scrolls into view.
 */
const REPO = "https://github.com/frankieramirez/bushel";
---

<footer class="colophon">
  <nav class="wrap colophon-links" aria-label="Project">
    <a href="/docs">Docs</a>
    <a href={REPO}>GitHub</a>
    <a href={`${REPO}/releases`}>Releases</a>
    <a href={`${REPO}/blob/main/SPEC.md`}>Spec</a>
    <a href={`${REPO}/issues/56`}>Roadmap</a>
    <a href={`${REPO}/blob/main/LICENSE`}>MIT license</a>
  </nav>

  <div class="plates display" aria-hidden="true">
    <span class="plate-pink">bushel</span>
    <span class="plate-blue">bushel</span>
  </div>

  <div class="wrap fine-print">
    <span>Printed in two inks</span>
    <span>Not affiliated with Apple · container is Apple's open-source CLI</span>
    <span>Illustration generated for this page</span>
    <span>Motion: 150 ms, or none at all</span>
  </div>
</footer>
