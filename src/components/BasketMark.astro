---
/**
 * The bushel mark: three apples over a slatted crate.
 * Small in the header as a stamped wordmark, large in the hero, centred in the
 * footer — the page's one symmetric moment.
 */
interface Props {
  size: number;
  class?: string;
}

const { size, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 200 200"
  fill="none"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  <path d="M104 40c-2-7 1-13 8-16 1 8-2 13-8 16z" fill="#7ee787"></path>
  <path d="M100 40v14" stroke="#7ee787" stroke-width="5" stroke-linecap="round"
  ></path>
  <circle cx="70" cy="82" r="27" fill="#d93a2b"></circle>
  <circle cx="130" cy="82" r="27" fill="#d93a2b"></circle>
  <circle cx="100" cy="62" r="27" fill="#e8503f"></circle>
  <rect x="24" y="96" width="152" height="18" fill="#f4ead6"></rect>
  <path d="M32 118h136l-16 62H48l-16-62z" fill="#f4ead6"></path>
  <path
    d="M62 118l-8 62M100 118v62M138 118l8 62"
    stroke="#123a24"
    stroke-width="4"></path>
  <path d="M40 148h120" stroke="#123a24" stroke-width="4"></path>
</svg>
