---
/**
 * The masthead, shared by the landing page and every docs page.
 *
 * The wordmark links home from anywhere except home itself, where a self-link
 * would be noise. "Docs" and the install button stay at every width; Spec and
 * GitHub fold away on a phone, where the colophon still carries them.
 */
import Arrow from "./Arrow.astro";
import ExternalArrow from "./ExternalArrow.astro";
import { isDocsPath } from "../lib/docs";
import { bushelDocs } from "../lib/bushelDocs";

const REPO = "https://github.com/frankieramirez/bushel";

const { version } = await bushelDocs();
const path = Astro.url.pathname;
const atHome = path === "/" || path === "";
const inDocs = isDocsPath(path);
---

<header class="masthead">
  <div class="wrap">
    {
      atHome ? (
        <span class="masthead-mark">
          <span class="wordmark">bushel</span>
          <span class="masthead-issue">Printed matter · Issue {version}</span>
        </span>
      ) : (
        <a class="masthead-mark" href="/" aria-label="bushel home">
          <span class="wordmark">bushel</span>
          <span class="masthead-issue">Printed matter · Issue {version}</span>
        </a>
      )
    }

    <nav class="masthead-nav" aria-label="Project">
      <a href="/docs" aria-current={inDocs ? "true" : undefined}>Docs</a>
      <a class="masthead-ext" href={`${REPO}/blob/main/SPEC.md`}
        >Spec <ExternalArrow /></a
      >
      <a class="masthead-ext" href={REPO}>GitHub <ExternalArrow /></a>
      <a class="take-one" href={atHome ? "#take-one" : "/#take-one"}
        >Take one <Arrow dir="down" /></a
      >
    </nav>
  </div>
</header>
